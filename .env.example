# Copy to .env. NEVER commit .env. All secrets below must be generated by you.
APP_NAME=PEP AI API
# development | test | production
ENVIRONMENT=development

# Database. SQLite is for local development only; production requires PostgreSQL.
DATABASE_URL=sqlite:///./pep_ai_dev.db
# Optional: privileged role used only by `alembic` (owner / BYPASSRLS). Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://pep_owner:...@db:5432/pepai

# REQUIRED in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# If empty in development/test a random ephemeral secret is generated (sessions reset on restart).
JWT_SECRET=
JWT_ISSUER=pep-ai
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Verification: default true outside development; cannot be disabled in production.
# REQUIRE_EMAIL_VERIFICATION=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Exact trusted web origins (https only in production, no wildcard).
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Base URL of the web app; used to build links in e-mails (https in production).
APP_BASE_URL=http://127.0.0.1:5500

# Rate limiting. Use redis when running more than one API instance.
RATE_LIMIT_ENABLED=true
# memory | redis
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://redis:6379/0
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=10
SENSITIVE_RATE_LIMIT_PER_HOUR=10
# Number of trusted reverse proxies in front of the API (for the real client IP). 0 = none.
TRUSTED_PROXY_HOPS=0

# E-mail. With EMAIL_PROVIDER=none NOTHING is sent (verification / reset / invitation mails are not delivered).
# For local development run a real SMTP catcher such as Mailpit and use smtp.
# none | smtp   (memory is reserved for automated tests)
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# WhatsApp alerts (Meta WhatsApp Cloud API). With WHATSAPP_PROVIDER=none nothing is sent.
# NOTE: Meta only allows free-text messages inside a 24-hour customer window; alerts sent outside it
# need an approved message template (configure in Meta Business Manager; see docs/TASKS_AND_ANALYTICS.md).
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# AI providers. Put keys ONLY here (server side). Never commit .env. Leave blank to disable a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
# Which provider answers the built-in Guide: auto (Anthropic, else OpenAI, else preset answers) | openai | anthropic | none
GUIDE_PROVIDER=auto
LLM_MAX_OUTPUT_TOKENS=800
AGENT_RATE_LIMIT_PER_HOUR=60
